# Auto-normalize text line endings to LF in the repository
# * text=auto lets git decide binary vs text, then we pin eol for known types.
* text=auto eol=lf

# --- C# ---
*.cs text eol=lf

# --- Unity YAML (are text) ---
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overridecontroller text eol=lf
*.mask text eol=lf
*.mixer text eol=lf
*.physicmaterial text eol=lf
*.physicsmaterial2d text eol=lf
*.lighting text eol=lf
*.playable text eol=lf
*.signal text eol=lf
*.spriteatlas text eol=lf
*.tilemap text eol=lf
*.scenesettings text eol=lf
*.meta text eol=lf

# --- Shader / graph ---
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.glsl text eol=lf
*.compute text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf

# --- Plain text ---
*.json text eol=lf
*.jsonc text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.asmdef text eol=lf
*.rsp text eol=lf
*.xml text eol=lf
*.config text eol=lf

# --- DOTNET / unity config ---
*.csproj text eol=lf
*.sln text eol=lf

# --- Unity YAML merge drivers (requires `git config merge.unityyamlmerge.driver ...`) ---
*.unity merge=unityyamlmerge
*.prefab merge=unityyamlmerge

# --- Binary files (never diff/merge) ---
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.tif binary
*.tiff binary
*.psd binary
*.exr binary
*.hdr binary
*.dds binary
